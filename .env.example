# ─── Supabase (Postgres) ────────────────────────────────────
# Project: https://qfptnyifzdwmuxfkgpmv.supabase.co
# Dashboard → Project Settings → Database
#
# DATABASE_URL  = Transaction pooler (port 6543) — app runtime
# DIRECT_URL    = Direct connection (port 5432) — migrations / seed
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Legacy local Docker (optional fallback)
# DATABASE_URL=postgresql://koridor:koridor@localhost:5432/koridor?schema=public
# DIRECT_URL=postgresql://koridor:koridor@localhost:5432/koridor?schema=public

# ─── Supabase API (Storage / future clients) ────────────────
SUPABASE_URL=https://qfptnyifzdwmuxfkgpmv.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://qfptnyifzdwmuxfkgpmv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Redis (local or managed) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
API_PREFIX=api/v1
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ─── JWT (NestJS auth — not Supabase Auth in Phase 1) ───────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Web ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Koridor

# ─── Storage (Supabase Storage) ─────────────────────────────
# Private bucket: org-documents (created in Phase 2)
# Prefer service-role uploads via Next.js API routes.
S3_ENDPOINT=https://qfptnyifzdwmuxfkgpmv.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=org-documents
S3_FORCE_PATH_STYLE=true

# ─── Email (optional in Phase 1) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@koridor.io
