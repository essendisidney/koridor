{
  "name": "koridor",
  "version": "1.0.0",
  "private": true,
  "description": "Koridor — operating system for cross-border trade",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@koridor/api",
    "dev:web": "turbo run dev --filter=@koridor/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @koridor/api prisma:generate",
    "db:migrate": "pnpm --filter @koridor/api prisma:migrate",
    "db:seed": "pnpm --filter @koridor/api prisma:seed",
    "db:studio": "pnpm --filter @koridor/api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
